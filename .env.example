# Copy to .env in this directory. Docker Compose and the local API both read it.
# Do not commit .env.

# Single operator. There is no registration screen.
ADMIN_USER=demo
ADMIN_PASS=demo1234

# At least 16 characters. Use a long random value before sharing the repo.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Browser origin allowed to call the API with cookies.
# On your own computer this stays http://localhost:3030.
# On a Linux server, set it to the address you type in the browser,
# for example http://203.0.113.10:3030
CLIENT_ORIGIN=http://localhost:3030

# Used when a dashboard request does not send a timeZone.
# Set this to your IANA zone so months match the calendar. Example: Asia/Hong_Kong
APP_TIMEZONE=UTC

# Local Node process. Docker Compose overrides this with the mongodb service hostname.
MONGODB_URI=mongodb://127.0.0.1:27017/freelancetrack

PORT=5050
NODE_ENV=development
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_PRETTY=true
# true only behind HTTPS. Leave false for local Docker on http://localhost.
COOKIE_SECURE=false
BCRYPT_ROUNDS=10
